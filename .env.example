APP_NAME=KontrolaDomu.pl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kontroladomu
DB_USERNAME=kontroladomu_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="powiadomienia@kontroladomu.pl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Konta i uwierzytelnianie (zadanie 002) ---
# Adres kontaktowy w tekstach i mailach. Wartość tymczasowa: podaj prawdziwy adres przed wdrożeniem.
CONTACT_EMAIL=kontakt@kontroladomu.pl
# Okno potwierdzenia hasła (sekundy) i ważność linku weryfikacyjnego e-mail (minuty).
AUTH_PASSWORD_TIMEOUT=900
AUTH_VERIFICATION_EXPIRE=1440
# Sprawdzanie haseł w wyciekach (Have I Been Pwned, k-anonimowość). Na produkcji zostaw true.
AUTH_CHECK_PWNED=true
# Cloudflare Turnstile. Poniżej klucze TESTOWE Cloudflare (zawsze przechodzą) - tylko lokalnie.
# Na produkcji TURNSTILE_ENABLED musi być true, a klucze prawdziwe (tylko na serwerze).
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Nagłówki bezpieczeństwa: CSP (tryb report-only pomaga przy dopisywaniu nowych domen).
CSP_ENABLED=true
CSP_REPORT_ONLY=false
# Zaufane proxy: lista zakresów IP Cloudflare po przecinku (aktualne: https://www.cloudflare.com/ips/), NIE "*".
# Ufamy wyłącznie nagłówkom X-Forwarded-For/-Port/-Proto. Puste = brak zaufania (lokalnie tak zostaw).
# Bez tego na produkcji limity "na IP" liczą adres proxy zamiast klienta. Przykład (stan z 2026, sprawdź listę!):
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
TRUSTED_PROXIES=
# Kolejka: lokalnie bez crona użyj QUEUE_CONNECTION=sync (maile wysyłane od razu) albo uruchom `php artisan queue:work`.
# Na produkcji: database + cron co minutę (`php artisan schedule:run`).
# Produkcja: użyj wzoru .env.production.example (aplikacja nie startuje na produkcji z kluczami testowymi, debugiem, sync, log).
