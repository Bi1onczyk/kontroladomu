# Wzór pliku .env dla PRODUKCJI (home.pl). Bez sekretów: puste wartości uzupełnij NA SERWERZE.
# Nie commituj wypełnionego pliku. Aplikacja nie wystartuje na produkcji, gdy poniższe zabezpieczenia
# są wyłączone (App\Support\Security\ProductionConfigGuard).

APP_NAME=KontrolaDomu.pl
APP_ENV=production
# Wygeneruj na serwerze: php artisan key:generate (zmiana klucza unieważnia 2FA wszystkich użytkowników).
APP_KEY=
APP_DEBUG=false
APP_URL=https://kontroladomu.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesje w bazie (kończenie sesji po zmianie hasła + AuthenticateSession), ciasteczko tylko po https.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# Kolejka w bazie + cron co minutę (php artisan schedule:run). NIGDY sync na produkcji.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Poczta przez SMTP (nigdy log/array: linki resetu hasła trafiałyby do logów).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=

AUTH_PASSWORD_TIMEOUT=900
AUTH_VERIFICATION_EXPIRE=1440
AUTH_CHECK_PWNED=true

# Cloudflare Turnstile: PRAWDZIWE klucze z panelu Cloudflare (klucze testowe Cloudflare są odrzucane przy starcie).
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CSP_ENABLED=true
CSP_REPORT_ONLY=false

# Zakresy IP Cloudflare po przecinku (aktualna lista: https://www.cloudflare.com/ips/), NIE "*".
# WYMAGANE: puste lub "*" = aplikacja nie wystartuje. Szczegóły: docs/DOKUMENTACJA_TECHNICZNA.md, rozdział "Wdrożenie".
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"

# --- Geokodowanie (Nominatim / OpenStreetMap) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Adres kontaktowy do nagłówka User-Agent (wymóg polityki Nominatim). DO USTALENIA z właścicielem.
# PUSTY = aplikacja startuje, ale NIE wysyła zapytań do publicznego Nominatim (tylko wyniki z cache).
NOMINATIM_CONTACT_EMAIL=

# --- Kopie zapasowe (spatie/laravel-backup) ---
# Adres alarmów o kopiach (błąd, zbyt stara kopia). DO USTALENIA z właścicielem.
# PUSTY = kopie działają, ale alarmów mailowych nie będzie (sprawdzaj: php artisan backup:list).
BACKUP_NOTIFICATION_EMAIL=
# WYMAGANE: hasło szyfrujące archiwa, min. 20 znaków (aplikacja nie wystartuje bez niego, bo w kopii plików jest .env
# z APP_KEY). Wygeneruj np.: php -r "echo bin2hex(random_bytes(16));" i zapisz w menedżerze haseł POZA serwerem.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISKS=backups
BACKUP_MAX_STORAGE_MB=3000
# Katalog z mysqldump (bez nazwy pliku); na hostingu zwykle puste (program jest w PATH).
DB_DUMP_BINARY_PATH=
